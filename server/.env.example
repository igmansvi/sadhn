NODE_ENV=development #for example: development
MONGODB_URI=your_mongodb_uri_here #for example: mongodb+srv://username:password@cluster.mongodb.net/database
PORT=5000 #for example: 5000
JWT_SECRET=your_jwt_secret_here #for example: your_secret_key
JWT_EXPIRE=7d #for example: 7d

CLIENT_URL=your_client_url_here #for example: http://localhost:3000
NGINX_URL=http://localhost:80 #for example: http://localhost:80

RESEND_API_KEY=your_resend_api_key_here #for example: re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=your_email_from_here #for example: your_email@example.com
EMAIL_TO=your_email_to_here #for example: admin@example.com